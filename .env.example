# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/uipirate
# Or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/uipirate?retryWrites=true&w=majority

# JWT Configuration — signs the dashboard session cookie (up_session).
# Generate a secure secret key using: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# Admin Setup (first-time only) — `npm run create-admin` reads these, or prompts.
# The script upserts a website-admin dashboard user. Safe to re-run.
ADMIN_EMAIL=admin@uipirate.com
ADMIN_PASSWORD=change-this-now
ADMIN_NAME=Website Admin

# Analytics rollup cron — protects GET /api/analytics/rollup (see vercel.json).
CRON_SECRET=generate-with-openssl-rand-base64-32

# --- Google Business Profile posting (optional) ---
# Ids come from Admin > Google Business > "Check connection". Either "123" or "accounts/123" works.
GBP_OAUTH_CLIENT_ID=
GBP_OAUTH_CLIENT_SECRET=
GBP_ACCOUNT_ID=107709971093576955039
GBP_LOCATION_ID=2312374460067595343

# Set to 1 to let the daily cron post automatically. Without it the cron only syncs the queue
# and reports what it would post; the manual "Publish now" button still works.
GBP_PUBLISH_ENABLED=
